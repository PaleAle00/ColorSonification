                   <widget class="QCheckBox" name="p_colour_on">
                    <property name="toolTip">
                     <string>Off: the original sound.  On: every strip's pad and bell notes take the timbre of the strip's colour class.</string>
                    </property>
                    <property name="text">
                     <string>dominant colour changes the timbre</string>
                    </property>
